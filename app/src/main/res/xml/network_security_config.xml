<?xml version="1.0" encoding="utf-8"?>
<!-- Allow cleartext (http://) so the app can reach a FastAPI server on your LAN
     by IP, e.g. http://192.168.1.20:8000. https:// (ngrok) works regardless. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
